{
  "name": "@meridian/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProofOfIntent backend: proposals, evidence hash chain, COI, verdicts, risk chain, watchdog.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "disclosures:sign": "tsx scripts/sign-disclosures.ts",
    "demo:halt": "tsx demo/halt-mip21.ts",
    "mocks:factcheck": "tsx scripts/refresh-factcheck-mocks.ts",
    "mocks:evidence": "tsx scripts/refresh-evidence-mocks.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@bull-board/api": "^9.10.5",
    "@bull-board/express": "^9.10.5",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.20.0",
    "bullmq": "^6.4.2",
    "canonicalize": "^5.1.0",
    "cors": "^2.8.6",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "graphology": "^0.26.0",
    "ioredis": "^6.0.0",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "graphology-types": "^0.24.8",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
