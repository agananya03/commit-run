# Copy to .env and fill in LLM_API_KEY. Never commit .env.

# Infra (docker-compose.yml)
DATABASE_URL=postgresql://meridian:meridian@localhost:5432/meridian
REDIS_URL=redis://localhost:6379

# Services
RPC_URL=http://127.0.0.1:8545
RAG_URL=http://localhost:8000
SIM_URL=http://localhost:4002

# LLM provider key used by rag
LLM_API_KEY=

# Hardhat default account #1 (0x70997970C51812dc3A010C7d01b50e0d17dc79C8).
# Public test key: local chain only, never use on a real network.
WATCHDOG_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# true = rag/sim clients read /shared/mocks instead of calling the services
USE_MOCKS=true
