          "enum": [
            "contradicts_claim",
            "undisclosed_change"
          ]
        },
        "claimId": {
          "type": "string",
          "description": "IntentClaim.id contradicted, when type is \"contradicts_claim\"."
        },
        "change": {
          "$ref": "#/definitions/ExecutionChange"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "explanation": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "change",
        "severity",
        "explanation"
      ],
      "additionalProperties": false,
      "description": "Executed effect that contradicts or was missing from the proposal text."
    },
    "EvidenceTrail": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvidenceEntry"
          }
        },
        "head": {
          "$ref": "#/definitions/Hash32"
        },
        "verified": {
          "type": "boolean",
          "description": "Recomputed every hash and matched the latest on-chain commit."
        }
      },
      "required": [
        "proposalId",
        "entries",
        "head",
        "verified"
      ],
      "additionalProperties": false,
      "description": "GET /proposals/:id/evidence"
    },
    "EvidenceEntry": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "index": {
          "type": "number"
        },
        "kind": {
          "$ref": "#/definitions/EvidenceKind"
        },
        "refId": {
          "type": "string",
          "description": "Id of the referenced object, e.g. a SourceDocument.id or job id."
        },
        "payloadHash": {
          "$ref": "#/definitions/Hash32",
          "description": "keccak256 of the canonical JSON (sorted keys) of the payload."
        },
        "prevHash": {
          "$ref": "#/definitions/Hash32"
        },
        "entryHash": {
          "$ref": "#/definitions/Hash32"
        },
        "commit": {
          "$ref": "#/definitions/EvidenceCommit",
          "description": "Set when this entry's hash was committed on chain as the chain head."
        },
        "createdAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "proposalId",
        "index",
        "kind",
        "payloadHash",
        "prevHash",
        "entryHash",
        "createdAt"
      ],
      "additionalProperties": false,
      "description": "One link of the hash chain. entryHash = keccak256(abi.encode(uint256 index, bytes32 prevHash, string kind, bytes32 payloadHash)) The genesis entry (index 0) has prevHash = 0x00...00."
    },
    "EvidenceKind": {
      "type": "string",
      "enum": [
        "source_document",
        "summary",
        "intent",
        "simulation",
        "coi",
        "voting",
        "risk",
        "flag"
      ]
    },
    "EvidenceCommit": {
      "type": "object",
      "properties": {
        "registry": {
          "$ref": "#/definitions/Address",
          "description": "EvidenceRegistry contract address."
        },
        "txHash": {
          "$ref": "#/definitions/Hash32"
        },
        "blockNumber": {
          "type": "number"
        },
        "committedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "registry",
        "txHash",
        "blockNumber",
        "committedAt"
      ],
      "additionalProperties": false
    },
    "FlagEvent": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "operationId": {
          "$ref": "#/definitions/Hash32"
        },
        "reason": {
          "type": "string"
        },
        "reasonHash": {
          "$ref": "#/definitions/Hash32",
          "description": "keccak256 of `reason`, as passed on chain."
        },
        "guard": {
          "$ref": "#/definitions/Address"
        },
        "txHash": {
          "$ref": "#/definitions/Hash32"
        },
        "blockNumber": {
          "type": "number"
        },
        "flaggedBy": {
          "$ref": "#/definitions/Address"
        },
        "auto": {
          "type": "boolean",
          "description": "True when raised by the pipeline, false for POST /flag."
        },
        "flaggedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "proposalId",
        "operationId",
        "reason",
        "reasonHash",
        "guard",
        "txHash",
        "blockNumber",
        "flaggedBy",
        "auto",
        "flaggedAt"
      ],
      "additionalProperties": false,
      "description": "Result of GovernanceGuard.flag(operationId, reasonHash)."
    }
  }
}
