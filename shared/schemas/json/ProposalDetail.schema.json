        },
        "confidence": {
          "$ref": "#/definitions/Probability"
        },
        "evidence": {
          "type": "string",
          "description": "Why we believe the link exists."
        },
        "txHash": {
          "$ref": "#/definitions/Hash32"
        },
        "documentId": {
          "type": "string"
        }
      },
      "required": [
