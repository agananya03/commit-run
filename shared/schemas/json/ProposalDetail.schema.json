    "RiskReport": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "baseRate": {
          "$ref": "#/definitions/Probability",
          "description": "Prior P(malicious) before any evidence."
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RiskStage"
          },
          "description": "Always in order: claims, coi, voting, execution."
        },
        "posterior": {
          "$ref": "#/definitions/Probability"
        },
        "level": {
          "$ref": "#/definitions/RiskLevel"
        },
        "deviations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Deviation"
          }
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "pass",
            "review",
            "flag"
          ]
        },
        "computedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "proposalId",
        "baseRate",
        "stages",
        "posterior",
        "level",
        "deviations",
        "recommendation",
        "computedAt"
      ],
      "additionalProperties": false,
      "description": "GET /proposals/:id/risk"
    },
    "RiskStage": {
      "type": "object",
      "properties": {
        "stage": {
          "$ref": "#/definitions/RiskStageName"
        },
        "prior": {
          "$ref": "#/definitions/Probability"
        },
        "likelihoodRatio": {
          "type": "number"
        },
        "posterior": {
          "$ref": "#/definitions/Probability"
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RiskSignal"
          }
        }
      },
      "required": [
        "stage",
        "prior",
        "likelihoodRatio",
        "posterior",
        "signals"
      ],
      "additionalProperties": false,
      "description": "One Bayesian update: posterior odds = prior odds * likelihoodRatio, where likelihoodRatio is the product of the signals' ratios. Each stage's prior is the previous stage's posterior."
    },
    "RiskStageName": {
      "type": "string",
      "enum": [
        "claims",
        "coi",
        "voting",
        "execution"
      ]
    },
    "RiskSignal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "likelihoodRatio": {
          "type": "number",
          "description": "Likelihood ratio this signal contributes; >1 raises risk, <1 lowers it."
        },
        "evidenceIndex": {
          "type": "number",
          "description": "EvidenceEntry.index backing this signal."
        }
      },
      "required": [
        "id",
        "description",
        "likelihoodRatio"
      ],
      "additionalProperties": false
    },
    "Deviation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
