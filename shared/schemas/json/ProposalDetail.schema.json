          "type": "number"
        },
        "deadlineBlock": {
          "type": "number"
        },
        "forVotes": {
          "$ref": "#/definitions/Uint256"
        },
        "againstVotes": {
          "$ref": "#/definitions/Uint256"
        },
        "abstainVotes": {
          "$ref": "#/definitions/Uint256"
        },
        "quorum": {
          "$ref": "#/definitions/Uint256"
        },
        "totalSupply": {
          "$ref": "#/definitions/Uint256"
        },
        "votes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Vote"
          }
        }
      },
      "required": [
        "proposalId",
        "snapshotBlock",
        "deadlineBlock",
        "forVotes",
        "againstVotes",
        "abstainVotes",
        "quorum",
        "totalSupply",
        "votes"
      ],
      "additionalProperties": false
    },
    "Vote": {
      "type": "object",
      "properties": {
        "voter": {
          "$ref": "#/definitions/Address"
        },
        "support": {
