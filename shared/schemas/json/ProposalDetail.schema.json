{
  "$id": "https://proofofintent.local/schemas/ProposalDetail.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ProposalDetail",
  "definitions": {
    "ProposalDetail": {
      "type": "object",
      "properties": {
        "proposal": {
          "$ref": "#/definitions/Proposal"
        },
        "onchain": {
          "$ref": "#/definitions/OnchainProposal"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceDocument"
          }
        },
        "summary": {
          "$ref": "#/definitions/SummarizeResponse"
        },
        "intent": {
          "$ref": "#/definitions/ExtractIntentResponse"
        },
        "simulation": {
          "$ref": "#/definitions/SimulateResponse"
        },
        "coi": {
          "$ref": "#/definitions/CoiGraph"
        },
        "voting": {
          "$ref": "#/definitions/VotingSnapshot"
        },
        "risk": {
          "$ref": "#/definitions/RiskReport"
        },
        "evidence": {
          "$ref": "#/definitions/EvidenceTrail"
        },
        "flag": {
          "$ref": "#/definitions/FlagEvent"
        }
      },
      "required": [
        "proposal",
        "documents",
        "evidence"
      ],
      "additionalProperties": false,
      "description": "GET /proposals/:id: everything the dashboard needs in one call."
    },
    "Proposal": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/ProposalId"
        },
        "title": {
          "type": "string"
        },
        "proposer": {
          "$ref": "#/definitions/Address"
        },
        "governorProposalId": {
          "$ref": "#/definitions/Uint256"
        },
        "operationId": {
          "$ref": "#/definitions/Hash32"
        },
        "state": {
          "$ref": "#/definitions/ProposalState"
        },
        "analysisStatus": {
          "anyOf": [
            {
              "$ref": "#/definitions/JobStatus"
            },
            {
              "type": "string",
              "const": "idle"
            }
          ]
        },
        "riskScore": {
          "$ref": "#/definitions/Probability",
          "description": "Final posterior of the risk chain, once scored."
        },
        "riskLevel": {
          "$ref": "#/definitions/RiskLevel"
        },
        "flagged": {
          "type": "boolean"
        },
        "createdAt": {
          "$ref": "#/definitions/IsoDateTime"
        },
        "updatedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "id",
        "title",
        "proposer",
        "state",
        "analysisStatus",
        "flagged",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    },
    "Address": {
      "type": "string",
      "description": "20-byte EVM address, 0x-prefixed (checksum optional).",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "Uint256": {
      "type": "string",
      "description": "uint256 as a base-10 string.",
      "pattern": "^[0-9]+$"
    },
    "Hash32": {
      "type": "string",
      "description": "32-byte hash, 0x-prefixed (keccak256 unless stated otherwise).",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "ProposalState": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "canceled",
        "defeated",
        "succeeded",
        "queued",
        "expired",
        "executed"
      ],
      "description": "OpenZeppelin Governor ProposalState, lower-cased."
    },
    "JobStatus": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ]
    },
    "Probability": {
      "type": "number",
      "description": "Probability in [0, 1].",
      "minimum": 0,
      "maximum": 1
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "IsoDateTime": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp.",
      "format": "date-time"
    },
    "OnchainProposal": {
      "type": "object",
      "properties": {
        "governorProposalId": {
          "$ref": "#/definitions/Uint256",
          "description": "Governor proposalId (uint256)."
        },
        "proposer": {
          "$ref": "#/definitions/Address"
        },
        "governor": {
          "$ref": "#/definitions/Address"
        },
        "timelock": {
          "$ref": "#/definitions/Address"
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimelockCall"
          }
        },
        "descriptionHash": {
          "$ref": "#/definitions/Hash32",
          "description": "keccak256 of the proposal description string."
        },
        "operationId": {
          "$ref": "#/definitions/Hash32",
          "description": "Timelock hashOperationBatch(targets, values, payloads, 0x0, descriptionHash)."
        }
      },
      "required": [
        "governorProposalId",
        "proposer",
        "governor",
        "timelock",
        "calls",
        "descriptionHash",
        "operationId"
      ],
      "additionalProperties": false,
      "description": "The proposal as submitted on chain (Governor + Timelock view)."
    },
    "TimelockCall": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/definitions/Address"
        },
        "value": {
          "$ref": "#/definitions/Uint256",
          "description": "ETH sent with the call, in wei."
        },
        "data": {
          "$ref": "#/definitions/HexData"
        }
      },
      "required": [
        "target",
        "value",
        "data"
      ],
      "additionalProperties": false,
      "description": "A single call inside a Timelock batch operation."
    },
    "HexData": {
      "type": "string",
      "description": "Arbitrary-length hex bytes, 0x-prefixed.",
      "pattern": "^0x([0-9a-fA-F]{2})*$"
    },
    "SourceDocument": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable id, \"<proposalId>:<kind>:<n>\", e.g. \"MIP-21:forum:0\"."
        },
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "kind": {
          "$ref": "#/definitions/SourceKind"
        },
        "uri": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string",
          "description": "Handle, ENS name or address of the author."
        },
        "publishedAt": {
          "$ref": "#/definitions/IsoDateTime"
        },
        "contentHash": {
          "$ref": "#/definitions/Hash32",
          "description": "keccak256 of the normalised document text; feeds the evidence chain."
        },
        "chunkCount": {
          "type": "number"
        },
        "excerpt": {
          "type": "string",
          "description": "First few hundred characters, for display."
        }
      },
      "required": [
        "id",
        "proposalId",
        "kind",
        "uri",
        "contentHash",
        "chunkCount"
      ],
      "additionalProperties": false
    },
    "SourceKind": {
      "type": "string",
      "enum": [
        "forum",
        "pdf",
        "social",
        "calldata"
      ]
    },
    "SummarizeResponse": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "keyPoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Citation"
          }
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "proposalId",
        "title",
        "summary",
        "keyPoints",
        "citations"
      ],
      "additionalProperties": false
    },
    "Citation": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "description": "SourceDocument.id the quote comes from."
        },
        "chunkId": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "description": "Verbatim excerpt supporting the statement."
        },
        "page": {
          "type": "number",
          "description": "1-based page number for PDFs."
        }
      },
      "required": [
        "documentId",
        "quote"
      ],
      "additionalProperties": false
    },
    "ExtractIntentResponse": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IntentClaim"
          }
        },
        "declaredTargets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Contract names or addresses the text says it touches."
        },
        "walletMentions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WalletMention"
          }
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "proposalId",
        "claims",
        "declaredTargets",
        "walletMentions"
      ],
      "additionalProperties": false
    },
    "IntentClaim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique within the response, e.g. \"c1\"."
        },
        "category": {
          "$ref": "#/definitions/ClaimCategory"
        },
        "statement": {
          "type": "string",
          "description": "Normalised statement, e.g. \"No change to ownership\"."
        },
        "expectation": {
          "type": "string",
          "enum": [
            "change",
            "no_change"
          ],
          "description": "Whether the text says this thing changes or explicitly stays the same."
        },
        "subject": {
          "type": "string",
          "description": "What the claim is about, e.g. \"MeridianReserve.owner\"."
        },
        "confidence": {
          "$ref": "#/definitions/Probability"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Citation"
          }
        }
      },
      "required": [
        "id",
        "category",
        "statement",
        "expectation",
        "confidence",
        "citations"
      ],
      "additionalProperties": false,
      "description": "Something the proposal text promises about its own effect."
    },
    "ClaimCategory": {
      "type": "string",
      "enum": [
        "gas",
        "ownership",
        "funds",
        "permissions",
        "upgrade",
        "parameters",
        "other"
      ]
    },
    "WalletMention": {
      "type": "object",
      "properties": {
        "address": {
          "$ref": "#/definitions/Address"
        },
        "documentId": {
          "type": "string"
        },
        "context": {
          "type": "string",
          "description": "Surrounding text, e.g. \"moving ops to my new wallet 0x9f2c...\"."
        }
      },
      "required": [
        "address",
        "documentId",
        "context"
      ],
      "additionalProperties": false,
      "description": "A wallet address mentioned in any source; input to the COI graph."
    },
    "SimulateResponse": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "operationId": {
          "$ref": "#/definitions/Hash32"
        },
        "forkBlock": {
          "type": "number"
        },
        "success": {
          "type": "boolean"
        },
        "revertReason": {
          "type": "string"
        },
        "gasUsed": {
          "type": "number"
        },
        "decodedCalls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DecodedCall"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExecutionChange"
          }
        },
        "gasBenchmarks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GasBenchmark"
          }
        },
        "simulatedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "proposalId",
        "forkBlock",
        "success",
        "gasUsed",
        "decodedCalls",
        "changes",
        "gasBenchmarks",
        "simulatedAt"
      ],
      "additionalProperties": false
    },
    "DecodedCall": {
      "type": "object",
      "properties": {
        "index": {
          "type": "number",
          "description": "Position in the batch (inner calls repeat their parent's index)."
        },
        "target": {
          "$ref": "#/definitions/Address"
        },
        "targetLabel": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/Uint256"
        },
        "selector": {
          "$ref": "#/definitions/Selector"
        },
        "signature": {
          "type": "string",
          "description": "e.g. \"upgradeToAndCall(address,bytes)\"; absent if unknown."
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DecodedArg"
          }
        },
        "innerCalls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DecodedCall"
          },
          "description": "Calls encoded inside this one, e.g. the initializer in upgradeToAndCall."
        }
      },
      "required": [
        "index",
        "target",
        "value",
        "selector",
        "args"
      ],
      "additionalProperties": false
    },
    "Selector": {
      "type": "string",
      "description": "4-byte function selector, 0x-prefixed.",
      "pattern": "^0x[0-9a-fA-F]{8}$"
    },
    "DecodedArg": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Solidity type, e.g. \"address\", \"uint256\", \"bytes\"."
        },
        "value": {
          "type": "string",
          "description": "Stringified value; bytes and arrays stay as hex / JSON text."
        }
      },
      "required": [
        "name",
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "ExecutionChange": {
      "anyOf": [
        {
          "$ref": "#/definitions/ImplementationChange"
        },
        {
          "$ref": "#/definitions/SelectorChange"
        },
        {
          "$ref": "#/definitions/OwnershipChange"
        },
        {
          "$ref": "#/definitions/RoleChange"
        },
        {
          "$ref": "#/definitions/ApprovalChange"
        },
        {
          "$ref": "#/definitions/BalanceChange"
        },
        {
          "$ref": "#/definitions/StorageChange"
        }
      ],
      "description": "Discriminated on `kind`."
    },
    "ImplementationChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "implementation_changed"
        },
        "before": {
          "$ref": "#/definitions/Address"
        },
        "after": {
          "$ref": "#/definitions/Address"
        },
        "newCodeHash": {
          "$ref": "#/definitions/Hash32",
          "description": "keccak256 of the new implementation's runtime bytecode."
        },
        "sourceVerified": {
          "type": "boolean",
          "description": "Whether the new implementation's source is known/verified."
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "newCodeHash",
        "severity",
        "sourceVerified"
      ],
      "additionalProperties": false
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "SelectorChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "enum": [
            "selector_added",
            "selector_removed"
          ]
        },
        "selector": {
          "$ref": "#/definitions/Selector"
        },
        "signature": {
          "type": "string"
        }
      },
      "required": [
        "contract",
        "description",
        "kind",
        "selector",
        "severity"
      ],
      "additionalProperties": false
    },
    "OwnershipChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "owner_changed"
        },
        "before": {
          "$ref": "#/definitions/Address"
        },
        "after": {
          "$ref": "#/definitions/Address"
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "severity"
      ],
      "additionalProperties": false
    },
    "RoleChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "enum": [
            "role_granted",
            "role_revoked"
          ]
        },
        "role": {
          "$ref": "#/definitions/Hash32"
        },
        "roleName": {
          "type": "string"
        },
        "account": {
          "$ref": "#/definitions/Address"
        }
      },
      "required": [
        "account",
        "contract",
        "description",
        "kind",
        "role",
        "severity"
      ],
      "additionalProperties": false
    },
    "ApprovalChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "approval_changed"
        },
        "tokenSymbol": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/definitions/Address"
        },
        "spender": {
          "$ref": "#/definitions/Address"
        },
        "before": {
          "$ref": "#/definitions/Uint256"
        },
        "after": {
          "$ref": "#/definitions/Uint256"
        },
        "unlimited": {
          "type": "boolean",
          "description": "True when `after` is type(uint256).max."
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "owner",
        "severity",
        "spender",
        "unlimited"
      ],
      "additionalProperties": false
    },
    "BalanceChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "balance_changed"
        },
        "tokenSymbol": {
          "type": "string",
          "description": "Absent for native ETH."
        },
        "account": {
          "$ref": "#/definitions/Address"
        },
        "before": {
          "$ref": "#/definitions/Uint256"
        },
        "after": {
          "$ref": "#/definitions/Uint256"
        }
      },
      "required": [
        "account",
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "severity"
      ],
      "additionalProperties": false
    },
    "StorageChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "storage_changed"
        },
        "slot": {
          "$ref": "#/definitions/Hash32"
        },
        "before": {
          "$ref": "#/definitions/Hash32"
        },
        "after": {
          "$ref": "#/definitions/Hash32"
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "severity",
        "slot"
      ],
      "additionalProperties": false
    },
    "GasBenchmark": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address"
        },
        "contractLabel": {
          "type": "string"
        },
        "signature": {
          "type": "string",
          "description": "e.g. \"deposit(uint256)\"."
        },
        "before": {
          "type": "number"
        },
        "after": {
          "type": "number"
        }
      },
      "required": [
        "contract",
        "signature",
        "before",
        "after"
      ],
      "additionalProperties": false,
      "description": "Gas cost of a function before vs after the proposal executes."
    },
    "CoiGraph": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WalletNode"
          }
        },
        "links": {
