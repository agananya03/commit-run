    "CoiFinding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "addresses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Address"
          }
        },
        "probability": {
          "$ref": "#/definitions/Probability"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        }
      },
      "required": [
        "id",
        "summary",
        "addresses",
