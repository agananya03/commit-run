{
  "$id": "https://proofofintent.local/schemas/IngestResponse.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/IngestResponse",
  "definitions": {
    "IngestResponse": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceDocument"
          }
        },
        "chunkCount": {
          "type": "number",
          "description": "Total chunks embedded into pgvector across all documents."
        },
        "onchain": {
          "$ref": "#/definitions/OnchainProposal",
          "description": "Parsed from the calldata source when one is ingested."
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Non-fatal problems, e.g. an unreadable PDF page."
        },
        "ingestedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "proposalId",
        "documents",
        "chunkCount",
        "warnings",
        "ingestedAt"
      ],
      "additionalProperties": false
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    },
    "SourceDocument": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable id, \"<proposalId>:<kind>:<n>\", e.g. \"MIP-21:forum:0\"."
        },
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "kind": {
          "$ref": "#/definitions/SourceKind"
        },
        "uri": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string",
          "description": "Handle, ENS name or address of the author."
        },
        "publishedAt": {
          "$ref": "#/definitions/IsoDateTime"
        },
        "contentHash": {
          "$ref": "#/definitions/Hash32",
          "description": "keccak256 of the normalised document text; feeds the evidence chain."
        },
        "chunkCount": {
          "type": "number"
        },
        "excerpt": {
          "type": "string",
          "description": "First few hundred characters, for display."
        }
      },
      "required": [
        "id",
        "proposalId",
        "kind",
        "uri",
        "contentHash",
        "chunkCount"
      ],
      "additionalProperties": false
    },
    "SourceKind": {
      "type": "string",
      "enum": [
        "forum",
        "pdf",
        "social",
        "calldata"
      ]
    },
    "IsoDateTime": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp.",
      "format": "date-time"
    },
    "Hash32": {
      "type": "string",
      "description": "32-byte hash, 0x-prefixed (keccak256 unless stated otherwise).",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "OnchainProposal": {
      "type": "object",
      "properties": {
        "governorProposalId": {
          "$ref": "#/definitions/Uint256",
          "description": "Governor proposalId (uint256)."
        },
        "proposer": {
          "$ref": "#/definitions/Address"
        },
        "governor": {
          "$ref": "#/definitions/Address"
        },
        "timelock": {
          "$ref": "#/definitions/Address"
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimelockCall"
          }
        },
        "descriptionHash": {
          "$ref": "#/definitions/Hash32",
          "description": "keccak256 of the proposal description string."
        },
        "operationId": {
          "$ref": "#/definitions/Hash32",
          "description": "Timelock hashOperationBatch(targets, values, payloads, 0x0, descriptionHash)."
        }
      },
      "required": [
        "governorProposalId",
        "proposer",
        "governor",
        "timelock",
        "calls",
        "descriptionHash",
        "operationId"
      ],
      "additionalProperties": false,
      "description": "The proposal as submitted on chain (Governor + Timelock view)."
    },
    "Uint256": {
      "type": "string",
      "description": "uint256 as a base-10 string.",
      "pattern": "^[0-9]+$"
    },
    "Address": {
      "type": "string",
      "description": "20-byte EVM address, 0x-prefixed (checksum optional).",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "TimelockCall": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/definitions/Address"
        },
        "value": {
          "$ref": "#/definitions/Uint256",
          "description": "ETH sent with the call, in wei."
        },
        "data": {
          "$ref": "#/definitions/HexData"
        }
      },
      "required": [
        "target",
        "value",
        "data"
      ],
      "additionalProperties": false,
      "description": "A single call inside a Timelock batch operation."
    },
    "HexData": {
      "type": "string",
      "description": "Arbitrary-length hex bytes, 0x-prefixed.",
      "pattern": "^0x([0-9a-fA-F]{2})*$"
    }
  }
}
