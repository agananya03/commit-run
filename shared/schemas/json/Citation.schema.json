{
  "$id": "https://proofofintent.local/schemas/Citation.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Citation",
  "definitions": {
    "Citation": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "description": "SourceDocument.id the quote comes from."
        },
        "chunkId": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "description": "Verbatim excerpt supporting the statement."
        },
        "page": {
          "type": "number",
          "description": "1-based page number for PDFs."
        }
      },
      "required": [
        "documentId",
        "quote"
      ],
      "additionalProperties": false
    }
  }
}
