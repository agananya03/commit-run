{
  "$id": "https://proofofintent.local/schemas/IngestRequest.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/IngestRequest",
  "definitions": {
    "IngestRequest": {
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "forum",
                  "pdf",
                  "social",
                  "onchain"
                ]
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "path"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "proposalId",
        "files"
      ],
      "additionalProperties": false,
      "description": "POST /ingest -> Chunk[]"
    }
  }
}
