{
  "$id": "https://proofofintent.local/schemas/IngestRequest.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/IngestRequest",
  "definitions": {
    "IngestRequest": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceInput"
          }
        }
      },
      "required": [
        "proposalId",
        "sources"
      ],
      "additionalProperties": false,
      "description": "POST /ingest"
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    },
    "SourceInput": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/SourceKind"
        },
        "uri": {
          "type": "string",
          "description": "Path relative to the repo root (e.g. data/MIP-21/forum.json) or a URL."
        }
      },
      "required": [
        "kind",
        "uri"
      ],
      "additionalProperties": false
    },
    "SourceKind": {
      "type": "string",
      "enum": [
        "forum",
        "pdf",
        "social",
        "calldata"
      ]
    }
  }
}
