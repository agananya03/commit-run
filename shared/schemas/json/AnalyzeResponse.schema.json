{
  "$id": "https://proofofintent.local/schemas/AnalyzeResponse.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AnalyzeResponse",
  "definitions": {
    "AnalyzeResponse": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "status": {
          "type": "string",
          "const": "queued"
        }
      },
      "required": [
        "jobId",
        "proposalId",
        "status"
      ],
      "additionalProperties": false
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    }
  }
}
