{
  "$id": "https://proofofintent.local/schemas/meridian.schema.json",
  "title": "Meridian",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Hex": {
      "type": "string"
    },
    "Chunk": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "proposalId": {
          "type": "string"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "forum",
            "pdf",
            "social",
            "onchain"
          ]
        },
        "sourceUri": {
          "type": "string"
        },
        "page": {
          "type": "number"
        },
        "text": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/definitions/Hex"
        }
      },
      "required": [
        "id",
        "proposalId",
        "sourceType",
        "sourceUri",
        "text",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Citation": {
      "type": "object",
      "properties": {
        "chunkId": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/definitions/Hex"
        },
        "quote": {
          "type": "string"
        },
        "sourceUri": {
          "type": "string"
        }
      },
      "required": [
        "chunkId",
        "sha256",
        "quote",
        "sourceUri"
      ],
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "financial",
            "technical",
            "team",
            "timeline",
            "other"
          ]
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Citation"
          }
        },
        "support": {
          "type": "string",
          "enum": [
            "supported",
            "unsupported",
            "contradicted"
          ]
        },
        "pSupported": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "text",
        "kind",
        "citations",
        "support",
        "pSupported"
      ],
      "additionalProperties": false
    },
    "DecisionSummary": {
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string"
        },
        "tldr": {
          "type": "string"
        },
        "treasuryImpact": {
          "type": "object",
          "properties": {
            "amountUsd": {
              "type": [
                "number",
                "null"
              ]
            },
            "pctOfTreasury": {
              "type": [
                "number",
                "null"
              ]
            },
            "recipients": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "citations": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Citation"
              }
            }
          },
          "required": [
            "amountUsd",
            "pctOfTreasury",
            "recipients",
            "citations"
          ],
          "additionalProperties": false
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "citations": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/Citation"
                }
              }
            },
            "required": [
              "text",
              "citations"
            ],
            "additionalProperties": false
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "citations": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/Citation"
                }
              }
            },
            "required": [
              "text",
              "citations"
            ],
            "additionalProperties": false
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Claim"
          }
        }
      },
      "required": [
        "proposalId",
        "tldr",
        "treasuryImpact",
        "dependencies",
        "risks",
        "claims"
      ],
      "additionalProperties": false
    },
    "IntentAction": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "transfer",
            "upgrade",
            "param_change",
            "approve",
            "call"
          ]
        },
        "target": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        },
        "recipient": {
          "type": "string"
        },
        "newImplementation": {
          "type": "string"
        },
        "functionSignature": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Citation"
          }
        }
      },
      "required": [
        "kind",
        "description",
        "citations"
      ],
      "additionalProperties": false
    },
    "IntentSpec": {
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IntentAction"
          }
        },
        "explicitlyExcluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number"
        }
      },
      "required": [
        "proposalId",
        "summary",
        "actions",
        "explicitlyExcluded",
        "confidence"
      ],
      "additionalProperties": false
    },
    "SimulationResult": {
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "revertReason": {
          "type": "string"
        },
        "decodedCalls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string"
              },
              "contractName": {
                "type": "string"
              },
              "selector": {
                "$ref": "#/definitions/Hex"
              },
              "signature": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {}
              }
            },
            "required": [
              "target",
              "selector",
              "args"
            ],
            "additionalProperties": false
          }
        },
        "tokenTransfers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "amount": {
                "type": "string"
              }
            },
            "required": [
              "token",
              "from",
              "to",
              "amount"
            ],
            "additionalProperties": false
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "spender": {
                "type": "string"
              },
              "amount": {
                "type": "string"
              }
            },
            "required": [
              "token",
              "owner",
              "spender",
              "amount"
            ],
            "additionalProperties": false
          }
        },
        "ownershipChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contract": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "before": {
                "type": "string"
              },
              "after": {
                "type": "string"
              }
            },
            "required": [
              "contract",
              "role",
              "before",
              "after"
            ],
            "additionalProperties": false
          }
        },
        "implementationChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "proxy": {
                "type": "string"
              },
              "before": {
                "type": "string"
              },
              "after": {
                "type": "string"
              },
              "addedSelectors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "selector": {
                      "$ref": "#/definitions/Hex"
                    },
                    "signature": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "selector"
                  ],
                  "additionalProperties": false
                }
              },
              "removedSelectors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "selector": {
                      "$ref": "#/definitions/Hex"
                    },
                    "signature": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "selector"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "proxy",
              "before",
              "after",
              "addedSelectors",
              "removedSelectors"
            ],
            "additionalProperties": false
          }
        },
        "storageDiffs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contract": {
                "type": "string"
              },
              "slot": {
                "$ref": "#/definitions/Hex"
              },
              "before": {
                "$ref": "#/definitions/Hex"
              },
              "after": {
                "$ref": "#/definitions/Hex"
              }
            },
            "required": [
              "contract",
              "slot",
              "before",
              "after"
            ],
            "additionalProperties": false
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "contract": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "args": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "contract",
              "name",
              "args"
            ],
            "additionalProperties": false
          }
        },
        "bytecodeHash": {
          "$ref": "#/definitions/Hex"
        },
        "simHash": {
          "$ref": "#/definitions/Hex"
        }
      },
      "required": [
        "proposalId",
        "success",
        "decodedCalls",
        "tokenTransfers",
        "approvals",
        "ownershipChanges",
        "implementationChanges",
        "storageDiffs",
        "events",
        "bytecodeHash",
        "simHash"
      ],
      "additionalProperties": false
    },
    "WalletLink": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hops": {
          "type": "number"
        },
        "pLink": {
          "type": "number"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "from",
        "to",
        "path",
        "hops",
        "pLink",
        "reasons"
      ],
      "additionalProperties": false
    },
    "CoiReport": {
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string"
        },
        "proposer": {
          "type": "string"
        },
        "disclosed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "signatureValid": {
          "type": "boolean"
        },
        "undisclosedLinks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WalletLink"
          }
        },
        "pCoi": {
          "type": "number"
        }
      },
      "required": [
        "proposalId",
        "proposer",
        "disclosed",
        "signatureValid",
        "undisclosedLinks",
        "pCoi"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "recipient_mismatch",
            "amount_mismatch",
            "undeclared_action",
            "ownership_change",
            "unlimited_approval",
            "new_privileged_function",
            "coi",
            "unsupported_claim",
            "contradiction"
          ]
        },
        "said": {
          "type": "string"
        },
        "does": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Citation"
          }
        },
        "simRef": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "category",
        "said",
        "does",
        "evidence"
      ],
      "additionalProperties": false
    },
    "RiskStage": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "claims",
            "coi",
            "voting",
            "execution"
          ]
        },
        "probability": {
          "type": "number"
        },
        "likelihoodRatio": {
          "type": "number"
        },
        "explanation": {
          "type": "string"
        },
        "findingIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "stage",
        "probability",
        "likelihoodRatio",
        "explanation",
        "findingIds"
      ],
      "additionalProperties": false
    },
    "RiskChain": {
      "type": "object",
      "properties": {
        "proposalId": {
          "type": "string"
        },
        "prior": {
          "type": "number"
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RiskStage"
          }
        },
        "posterior": {
          "type": "number"
        },
        "level": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "none",
            "review",
            "halt"
          ]
        }
      },
      "required": [
        "proposalId",
        "prior",
        "stages",
        "posterior",
        "level",
        "action"
      ],
      "additionalProperties": false
    }
  }
}
