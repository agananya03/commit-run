{
  "$id": "https://proofofintent.local/schemas/RiskReport.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/RiskReport",
  "definitions": {
    "RiskReport": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "baseRate": {
          "$ref": "#/definitions/Probability",
          "description": "Prior P(malicious) before any evidence."
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RiskStage"
          },
          "description": "Always in order: claims, coi, voting, execution."
        },
        "posterior": {
          "$ref": "#/definitions/Probability"
        },
        "level": {
          "$ref": "#/definitions/RiskLevel"
        },
        "deviations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Deviation"
          }
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "pass",
            "review",
            "flag"
          ]
        },
        "computedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "proposalId",
        "baseRate",
        "stages",
        "posterior",
        "level",
        "deviations",
        "recommendation",
        "computedAt"
      ],
      "additionalProperties": false,
      "description": "GET /proposals/:id/risk"
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    },
    "Probability": {
      "type": "number",
      "description": "Probability in [0, 1].",
      "minimum": 0,
      "maximum": 1
    },
    "RiskStage": {
      "type": "object",
      "properties": {
        "stage": {
          "$ref": "#/definitions/RiskStageName"
        },
        "prior": {
          "$ref": "#/definitions/Probability"
        },
        "likelihoodRatio": {
          "type": "number"
        },
        "posterior": {
          "$ref": "#/definitions/Probability"
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RiskSignal"
          }
        }
      },
      "required": [
        "stage",
        "prior",
        "likelihoodRatio",
        "posterior",
        "signals"
      ],
      "additionalProperties": false,
      "description": "One Bayesian update: posterior odds = prior odds * likelihoodRatio, where likelihoodRatio is the product of the signals' ratios. Each stage's prior is the previous stage's posterior."
    },
    "RiskStageName": {
      "type": "string",
      "enum": [
        "claims",
        "coi",
        "voting",
        "execution"
      ]
    },
    "RiskSignal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "likelihoodRatio": {
          "type": "number",
          "description": "Likelihood ratio this signal contributes; >1 raises risk, <1 lowers it."
        },
        "evidenceIndex": {
          "type": "number",
          "description": "EvidenceEntry.index backing this signal."
        }
      },
      "required": [
        "id",
        "description",
        "likelihoodRatio"
      ],
      "additionalProperties": false
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "Deviation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "contradicts_claim",
            "undisclosed_change"
          ]
        },
        "claimId": {
          "type": "string",
          "description": "IntentClaim.id contradicted, when type is \"contradicts_claim\"."
        },
        "change": {
          "$ref": "#/definitions/ExecutionChange"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "explanation": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "change",
        "severity",
        "explanation"
      ],
      "additionalProperties": false,
      "description": "Executed effect that contradicts or was missing from the proposal text."
    },
    "ExecutionChange": {
      "anyOf": [
        {
          "$ref": "#/definitions/ImplementationChange"
        },
        {
          "$ref": "#/definitions/SelectorChange"
        },
        {
          "$ref": "#/definitions/OwnershipChange"
        },
        {
          "$ref": "#/definitions/RoleChange"
        },
        {
          "$ref": "#/definitions/ApprovalChange"
        },
        {
          "$ref": "#/definitions/BalanceChange"
        },
        {
          "$ref": "#/definitions/StorageChange"
        }
      ],
      "description": "Discriminated on `kind`."
    },
    "ImplementationChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "implementation_changed"
        },
        "before": {
          "$ref": "#/definitions/Address"
        },
        "after": {
          "$ref": "#/definitions/Address"
        },
        "newCodeHash": {
          "$ref": "#/definitions/Hash32",
          "description": "keccak256 of the new implementation's runtime bytecode."
        },
        "sourceVerified": {
          "type": "boolean",
          "description": "Whether the new implementation's source is known/verified."
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "newCodeHash",
        "severity",
        "sourceVerified"
      ],
      "additionalProperties": false
    },
    "Address": {
      "type": "string",
      "description": "20-byte EVM address, 0x-prefixed (checksum optional).",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "Hash32": {
      "type": "string",
      "description": "32-byte hash, 0x-prefixed (keccak256 unless stated otherwise).",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "SelectorChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "enum": [
            "selector_added",
            "selector_removed"
          ]
        },
        "selector": {
          "$ref": "#/definitions/Selector"
        },
        "signature": {
          "type": "string"
        }
      },
      "required": [
        "contract",
        "description",
        "kind",
        "selector",
        "severity"
      ],
      "additionalProperties": false
    },
    "Selector": {
      "type": "string",
      "description": "4-byte function selector, 0x-prefixed.",
      "pattern": "^0x[0-9a-fA-F]{8}$"
    },
    "OwnershipChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "owner_changed"
        },
        "before": {
          "$ref": "#/definitions/Address"
        },
        "after": {
          "$ref": "#/definitions/Address"
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "severity"
      ],
      "additionalProperties": false
    },
    "RoleChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "enum": [
            "role_granted",
            "role_revoked"
          ]
        },
        "role": {
          "$ref": "#/definitions/Hash32"
        },
        "roleName": {
          "type": "string"
        },
        "account": {
          "$ref": "#/definitions/Address"
        }
      },
      "required": [
        "account",
        "contract",
        "description",
        "kind",
        "role",
        "severity"
      ],
      "additionalProperties": false
    },
    "ApprovalChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "approval_changed"
        },
        "tokenSymbol": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/definitions/Address"
        },
        "spender": {
          "$ref": "#/definitions/Address"
        },
        "before": {
          "$ref": "#/definitions/Uint256"
        },
        "after": {
          "$ref": "#/definitions/Uint256"
        },
        "unlimited": {
          "type": "boolean",
          "description": "True when `after` is type(uint256).max."
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "owner",
        "severity",
        "spender",
        "unlimited"
      ],
      "additionalProperties": false
    },
    "Uint256": {
      "type": "string",
      "description": "uint256 as a base-10 string.",
      "pattern": "^[0-9]+$"
    },
    "BalanceChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "balance_changed"
        },
        "tokenSymbol": {
          "type": "string",
          "description": "Absent for native ETH."
        },
        "account": {
          "$ref": "#/definitions/Address"
        },
        "before": {
          "$ref": "#/definitions/Uint256"
        },
        "after": {
          "$ref": "#/definitions/Uint256"
        }
      },
      "required": [
        "account",
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "severity"
      ],
      "additionalProperties": false
    },
    "StorageChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "storage_changed"
        },
        "slot": {
          "$ref": "#/definitions/Hash32"
        },
        "before": {
          "$ref": "#/definitions/Hash32"
        },
        "after": {
          "$ref": "#/definitions/Hash32"
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "severity",
        "slot"
      ],
      "additionalProperties": false
    },
    "IsoDateTime": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp.",
      "format": "date-time"
    }
  }
}
