{
  "$id": "https://proofofintent.local/schemas/SourceInput.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SourceInput",
  "definitions": {
    "SourceInput": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/SourceKind"
        },
        "uri": {
          "type": "string",
          "description": "Path relative to the repo root (e.g. data/MIP-21/forum.json) or a URL."
        }
      },
      "required": [
        "kind",
        "uri"
      ],
      "additionalProperties": false
    },
    "SourceKind": {
      "type": "string",
      "enum": [
        "forum",
        "pdf",
        "social",
        "calldata"
      ]
    }
  }
}
