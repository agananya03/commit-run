{
  "$id": "https://proofofintent.local/schemas/SimulateRequest.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SimulateRequest",
  "definitions": {
    "SimulateRequest": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "operationId": {
          "$ref": "#/definitions/Hash32"
        },
        "executor": {
          "$ref": "#/definitions/Address",
          "description": "Account the calls are executed from (the Timelock)."
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimelockCall"
          }
        },
        "forkBlock": {
          "type": "number",
          "description": "Fork from this block; latest when omitted."
        }
      },
      "required": [
        "proposalId",
        "executor",
        "calls"
      ],
      "additionalProperties": false,
      "description": "POST /simulate"
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    },
    "Hash32": {
      "type": "string",
      "description": "32-byte hash, 0x-prefixed (keccak256 unless stated otherwise).",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "Address": {
      "type": "string",
      "description": "20-byte EVM address, 0x-prefixed (checksum optional).",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "TimelockCall": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/definitions/Address"
        },
        "value": {
          "$ref": "#/definitions/Uint256",
          "description": "ETH sent with the call, in wei."
        },
        "data": {
          "$ref": "#/definitions/HexData"
        }
      },
      "required": [
        "target",
        "value",
        "data"
      ],
      "additionalProperties": false,
      "description": "A single call inside a Timelock batch operation."
    },
    "Uint256": {
      "type": "string",
      "description": "uint256 as a base-10 string.",
      "pattern": "^[0-9]+$"
    },
    "HexData": {
      "type": "string",
      "description": "Arbitrary-length hex bytes, 0x-prefixed.",
      "pattern": "^0x([0-9a-fA-F]{2})*$"
    }
  }
}
