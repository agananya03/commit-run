{
  "$id": "https://proofofintent.local/schemas/SocketEventMap.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SocketEventMap",
  "definitions": {
    "SocketEventMap": {
      "type": "object",
      "properties": {
        "analysis:progress": {
          "$ref": "#/definitions/AnalysisProgressEvent"
        },
        "analysis:completed": {
          "$ref": "#/definitions/AnalysisCompletedEvent"
        },
        "evidence:appended": {
          "$ref": "#/definitions/EvidenceEntry"
        },
        "proposal:flagged": {
          "$ref": "#/definitions/FlagEvent"
        }
      },
      "required": [
        "analysis:progress",
        "analysis:completed",
        "evidence:appended",
        "proposal:flagged"
      ],
      "additionalProperties": false,
      "description": "Event name -> payload. Clients join room \"proposal:<id>\" to receive them."
    },
    "AnalysisProgressEvent": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "step": {
          "$ref": "#/definitions/AnalysisStep"
        },
        "status": {
          "type": "string",
          "enum": [
            "started",
            "completed",
            "failed"
          ]
        },
        "progress": {
          "type": "number",
          "description": "0 to 100, for the whole job."
        },
        "message": {
          "type": "string"
        },
        "at": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "jobId",
        "proposalId",
        "step",
        "status",
        "progress",
        "at"
      ],
      "additionalProperties": false
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    },
    "AnalysisStep": {
      "type": "string",
      "enum": [
        "ingest",
        "summarize",
        "extract_intent",
        "simulate",
        "coi",
        "voting",
        "score",
        "commit",
        "flag"
      ]
    },
    "IsoDateTime": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp.",
      "format": "date-time"
    },
    "AnalysisCompletedEvent": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "risk": {
          "$ref": "#/definitions/RiskReport"
        },
        "flagged": {
          "type": "boolean"
        }
      },
      "required": [
        "jobId",
        "proposalId",
        "risk",
        "flagged"
      ],
      "additionalProperties": false
    },
    "RiskReport": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "baseRate": {
          "$ref": "#/definitions/Probability",
          "description": "Prior P(malicious) before any evidence."
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RiskStage"
          },
          "description": "Always in order: claims, coi, voting, execution."
        },
        "posterior": {
          "$ref": "#/definitions/Probability"
        },
        "level": {
          "$ref": "#/definitions/RiskLevel"
        },
        "deviations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Deviation"
          }
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "pass",
            "review",
            "flag"
          ]
        },
        "computedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "proposalId",
        "baseRate",
        "stages",
        "posterior",
        "level",
        "deviations",
        "recommendation",
        "computedAt"
      ],
      "additionalProperties": false,
      "description": "GET /proposals/:id/risk"
    },
    "Probability": {
      "type": "number",
      "description": "Probability in [0, 1].",
      "minimum": 0,
      "maximum": 1
    },
    "RiskStage": {
      "type": "object",
      "properties": {
        "stage": {
          "$ref": "#/definitions/RiskStageName"
        },
        "prior": {
          "$ref": "#/definitions/Probability"
        },
        "likelihoodRatio": {
          "type": "number"
        },
        "posterior": {
          "$ref": "#/definitions/Probability"
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RiskSignal"
          }
        }
      },
      "required": [
        "stage",
        "prior",
        "likelihoodRatio",
        "posterior",
        "signals"
      ],
      "additionalProperties": false,
      "description": "One Bayesian update: posterior odds = prior odds * likelihoodRatio, where likelihoodRatio is the product of the signals' ratios. Each stage's prior is the previous stage's posterior."
    },
    "RiskStageName": {
      "type": "string",
      "enum": [
        "claims",
        "coi",
        "voting",
        "execution"
      ]
    },
    "RiskSignal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "likelihoodRatio": {
          "type": "number",
          "description": "Likelihood ratio this signal contributes; >1 raises risk, <1 lowers it."
        },
        "evidenceIndex": {
          "type": "number",
          "description": "EvidenceEntry.index backing this signal."
        }
      },
      "required": [
        "id",
        "description",
        "likelihoodRatio"
      ],
      "additionalProperties": false
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "Deviation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "contradicts_claim",
            "undisclosed_change"
          ]
        },
        "claimId": {
          "type": "string",
          "description": "IntentClaim.id contradicted, when type is \"contradicts_claim\"."
        },
        "change": {
          "$ref": "#/definitions/ExecutionChange"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "explanation": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "change",
        "severity",
        "explanation"
      ],
      "additionalProperties": false,
      "description": "Executed effect that contradicts or was missing from the proposal text."
    },
    "ExecutionChange": {
      "anyOf": [
        {
          "$ref": "#/definitions/ImplementationChange"
        },
        {
          "$ref": "#/definitions/SelectorChange"
        },
        {
          "$ref": "#/definitions/OwnershipChange"
        },
        {
          "$ref": "#/definitions/RoleChange"
        },
        {
          "$ref": "#/definitions/ApprovalChange"
        },
        {
          "$ref": "#/definitions/BalanceChange"
        },
        {
          "$ref": "#/definitions/StorageChange"
        }
      ],
      "description": "Discriminated on `kind`."
    },
    "ImplementationChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "implementation_changed"
        },
        "before": {
          "$ref": "#/definitions/Address"
        },
        "after": {
          "$ref": "#/definitions/Address"
        },
        "newCodeHash": {
          "$ref": "#/definitions/Hash32",
          "description": "keccak256 of the new implementation's runtime bytecode."
        },
        "sourceVerified": {
          "type": "boolean",
          "description": "Whether the new implementation's source is known/verified."
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "newCodeHash",
        "severity",
        "sourceVerified"
      ],
      "additionalProperties": false
    },
    "Address": {
      "type": "string",
      "description": "20-byte EVM address, 0x-prefixed (checksum optional).",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "Hash32": {
      "type": "string",
      "description": "32-byte hash, 0x-prefixed (keccak256 unless stated otherwise).",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "SelectorChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "enum": [
            "selector_added",
            "selector_removed"
          ]
        },
        "selector": {
          "$ref": "#/definitions/Selector"
        },
        "signature": {
          "type": "string"
        }
      },
      "required": [
        "contract",
        "description",
        "kind",
        "selector",
        "severity"
      ],
      "additionalProperties": false
    },
    "Selector": {
      "type": "string",
      "description": "4-byte function selector, 0x-prefixed.",
      "pattern": "^0x[0-9a-fA-F]{8}$"
    },
    "OwnershipChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "owner_changed"
        },
        "before": {
          "$ref": "#/definitions/Address"
        },
        "after": {
          "$ref": "#/definitions/Address"
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "severity"
      ],
      "additionalProperties": false
    },
    "RoleChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "enum": [
            "role_granted",
            "role_revoked"
          ]
        },
        "role": {
          "$ref": "#/definitions/Hash32"
        },
        "roleName": {
          "type": "string"
        },
        "account": {
          "$ref": "#/definitions/Address"
        }
      },
      "required": [
        "account",
        "contract",
        "description",
        "kind",
        "role",
        "severity"
      ],
      "additionalProperties": false
    },
    "ApprovalChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "approval_changed"
        },
        "tokenSymbol": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/definitions/Address"
        },
        "spender": {
          "$ref": "#/definitions/Address"
        },
        "before": {
          "$ref": "#/definitions/Uint256"
        },
        "after": {
          "$ref": "#/definitions/Uint256"
        },
        "unlimited": {
          "type": "boolean",
          "description": "True when `after` is type(uint256).max."
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "owner",
        "severity",
        "spender",
        "unlimited"
      ],
      "additionalProperties": false
    },
    "Uint256": {
      "type": "string",
      "description": "uint256 as a base-10 string.",
      "pattern": "^[0-9]+$"
    },
    "BalanceChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "balance_changed"
        },
        "tokenSymbol": {
          "type": "string",
          "description": "Absent for native ETH."
        },
        "account": {
          "$ref": "#/definitions/Address"
        },
        "before": {
          "$ref": "#/definitions/Uint256"
        },
        "after": {
          "$ref": "#/definitions/Uint256"
        }
      },
      "required": [
        "account",
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "severity"
      ],
      "additionalProperties": false
    },
    "StorageChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "storage_changed"
        },
        "slot": {
          "$ref": "#/definitions/Hash32"
        },
        "before": {
          "$ref": "#/definitions/Hash32"
        },
        "after": {
          "$ref": "#/definitions/Hash32"
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "severity",
        "slot"
      ],
      "additionalProperties": false
    },
    "EvidenceEntry": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "index": {
          "type": "number"
        },
        "kind": {
          "$ref": "#/definitions/EvidenceKind"
        },
        "refId": {
          "type": "string",
          "description": "Id of the referenced object, e.g. a SourceDocument.id or job id."
        },
        "payloadHash": {
          "$ref": "#/definitions/Hash32",
          "description": "keccak256 of the canonical JSON (sorted keys) of the payload."
        },
        "prevHash": {
          "$ref": "#/definitions/Hash32"
        },
        "entryHash": {
          "$ref": "#/definitions/Hash32"
        },
        "commit": {
          "$ref": "#/definitions/EvidenceCommit",
          "description": "Set when this entry's hash was committed on chain as the chain head."
        },
        "createdAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "proposalId",
        "index",
        "kind",
        "payloadHash",
        "prevHash",
        "entryHash",
        "createdAt"
      ],
      "additionalProperties": false,
      "description": "One link of the hash chain. entryHash = keccak256(abi.encode(uint256 index, bytes32 prevHash, string kind, bytes32 payloadHash)) The genesis entry (index 0) has prevHash = 0x00...00."
    },
    "EvidenceKind": {
      "type": "string",
      "enum": [
        "source_document",
        "summary",
        "intent",
        "simulation",
        "coi",
        "voting",
        "risk",
        "flag"
      ]
    },
    "EvidenceCommit": {
      "type": "object",
      "properties": {
        "registry": {
          "$ref": "#/definitions/Address",
          "description": "EvidenceRegistry contract address."
        },
        "txHash": {
          "$ref": "#/definitions/Hash32"
        },
        "blockNumber": {
          "type": "number"
        },
        "committedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "registry",
        "txHash",
        "blockNumber",
        "committedAt"
      ],
      "additionalProperties": false
    },
    "FlagEvent": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "operationId": {
          "$ref": "#/definitions/Hash32"
        },
        "reason": {
          "type": "string"
        },
        "reasonHash": {
          "$ref": "#/definitions/Hash32",
          "description": "keccak256 of `reason`, as passed on chain."
        },
        "guard": {
          "$ref": "#/definitions/Address"
        },
        "txHash": {
          "$ref": "#/definitions/Hash32"
        },
        "blockNumber": {
          "type": "number"
        },
        "flaggedBy": {
          "$ref": "#/definitions/Address"
        },
        "auto": {
          "type": "boolean",
          "description": "True when raised by the pipeline, false for POST /flag."
        },
        "flaggedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "proposalId",
        "operationId",
        "reason",
        "reasonHash",
        "guard",
        "txHash",
        "blockNumber",
        "flaggedBy",
        "auto",
        "flaggedAt"
      ],
      "additionalProperties": false,
      "description": "Result of GovernanceGuard.flag(operationId, reasonHash)."
    }
  }
}
