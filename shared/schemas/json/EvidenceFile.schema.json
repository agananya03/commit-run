{
  "$id": "https://proofofintent.local/schemas/EvidenceFile.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/EvidenceFile",
  "definitions": {
    "EvidenceFile": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "forum",
            "pdf",
            "social",
            "onchain",
            "disclosure"
          ]
        },
        "uri": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/definitions/Hex"
        },
        "bytes": {
          "type": "number"
        },
        "proof": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Hex"
          }
        }
      },
      "required": [
        "type",
        "uri",
        "sha256",
        "bytes",
        "proof"
      ],
      "additionalProperties": false,
      "description": "One evidence file of a version. proof = Merkle proof of leaf [type, sha256] in StandardMerkleTree."
    },
    "Hex": {
      "type": "string"
    }
  }
}
