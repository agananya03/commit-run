{
  "$id": "https://proofofintent.local/schemas/SimulateResponse.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SimulateResponse",
  "definitions": {
    "SimulateResponse": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "operationId": {
          "$ref": "#/definitions/Hash32"
        },
        "forkBlock": {
          "type": "number"
        },
        "success": {
          "type": "boolean"
        },
        "revertReason": {
          "type": "string"
        },
        "gasUsed": {
          "type": "number"
        },
        "decodedCalls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DecodedCall"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExecutionChange"
          }
        },
        "gasBenchmarks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GasBenchmark"
          }
        },
        "simulatedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "proposalId",
        "forkBlock",
        "success",
        "gasUsed",
        "decodedCalls",
        "changes",
        "gasBenchmarks",
        "simulatedAt"
      ],
      "additionalProperties": false
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    },
    "Hash32": {
      "type": "string",
      "description": "32-byte hash, 0x-prefixed (keccak256 unless stated otherwise).",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "DecodedCall": {
      "type": "object",
      "properties": {
        "index": {
          "type": "number",
          "description": "Position in the batch (inner calls repeat their parent's index)."
        },
        "target": {
          "$ref": "#/definitions/Address"
        },
        "targetLabel": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/Uint256"
        },
        "selector": {
          "$ref": "#/definitions/Selector"
        },
        "signature": {
          "type": "string",
          "description": "e.g. \"upgradeToAndCall(address,bytes)\"; absent if unknown."
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DecodedArg"
          }
        },
        "innerCalls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DecodedCall"
          },
          "description": "Calls encoded inside this one, e.g. the initializer in upgradeToAndCall."
        }
      },
      "required": [
        "index",
        "target",
        "value",
        "selector",
        "args"
      ],
      "additionalProperties": false
    },
    "Address": {
      "type": "string",
      "description": "20-byte EVM address, 0x-prefixed (checksum optional).",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "Uint256": {
      "type": "string",
      "description": "uint256 as a base-10 string.",
      "pattern": "^[0-9]+$"
    },
    "Selector": {
      "type": "string",
      "description": "4-byte function selector, 0x-prefixed.",
      "pattern": "^0x[0-9a-fA-F]{8}$"
    },
    "DecodedArg": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Solidity type, e.g. \"address\", \"uint256\", \"bytes\"."
        },
        "value": {
          "type": "string",
          "description": "Stringified value; bytes and arrays stay as hex / JSON text."
        }
      },
      "required": [
        "name",
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "ExecutionChange": {
      "anyOf": [
        {
          "$ref": "#/definitions/ImplementationChange"
        },
        {
          "$ref": "#/definitions/SelectorChange"
        },
        {
          "$ref": "#/definitions/OwnershipChange"
        },
        {
          "$ref": "#/definitions/RoleChange"
        },
        {
          "$ref": "#/definitions/ApprovalChange"
        },
        {
          "$ref": "#/definitions/BalanceChange"
        },
        {
          "$ref": "#/definitions/StorageChange"
        }
      ],
      "description": "Discriminated on `kind`."
    },
    "ImplementationChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "implementation_changed"
        },
        "before": {
          "$ref": "#/definitions/Address"
        },
        "after": {
          "$ref": "#/definitions/Address"
        },
        "newCodeHash": {
          "$ref": "#/definitions/Hash32",
          "description": "keccak256 of the new implementation's runtime bytecode."
        },
        "sourceVerified": {
          "type": "boolean",
          "description": "Whether the new implementation's source is known/verified."
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "newCodeHash",
        "severity",
        "sourceVerified"
      ],
      "additionalProperties": false
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "SelectorChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "enum": [
            "selector_added",
            "selector_removed"
          ]
        },
        "selector": {
          "$ref": "#/definitions/Selector"
        },
        "signature": {
          "type": "string"
        }
      },
      "required": [
        "contract",
        "description",
        "kind",
        "selector",
        "severity"
      ],
      "additionalProperties": false
    },
    "OwnershipChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "owner_changed"
        },
        "before": {
          "$ref": "#/definitions/Address"
        },
        "after": {
          "$ref": "#/definitions/Address"
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "severity"
      ],
      "additionalProperties": false
    },
    "RoleChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "enum": [
            "role_granted",
            "role_revoked"
          ]
        },
        "role": {
          "$ref": "#/definitions/Hash32"
        },
        "roleName": {
          "type": "string"
        },
        "account": {
          "$ref": "#/definitions/Address"
        }
      },
      "required": [
        "account",
        "contract",
        "description",
        "kind",
        "role",
        "severity"
      ],
      "additionalProperties": false
    },
    "ApprovalChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "approval_changed"
        },
        "tokenSymbol": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/definitions/Address"
        },
        "spender": {
          "$ref": "#/definitions/Address"
        },
        "before": {
          "$ref": "#/definitions/Uint256"
        },
        "after": {
          "$ref": "#/definitions/Uint256"
        },
        "unlimited": {
          "type": "boolean",
          "description": "True when `after` is type(uint256).max."
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "owner",
        "severity",
        "spender",
        "unlimited"
      ],
      "additionalProperties": false
    },
    "BalanceChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "balance_changed"
        },
        "tokenSymbol": {
          "type": "string",
          "description": "Absent for native ETH."
        },
        "account": {
          "$ref": "#/definitions/Address"
        },
        "before": {
          "$ref": "#/definitions/Uint256"
        },
        "after": {
          "$ref": "#/definitions/Uint256"
        }
      },
      "required": [
        "account",
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "severity"
      ],
      "additionalProperties": false
    },
    "StorageChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "const": "storage_changed"
        },
        "slot": {
          "$ref": "#/definitions/Hash32"
        },
        "before": {
          "$ref": "#/definitions/Hash32"
        },
        "after": {
          "$ref": "#/definitions/Hash32"
        }
      },
      "required": [
        "after",
        "before",
        "contract",
        "description",
        "kind",
        "severity",
        "slot"
      ],
      "additionalProperties": false
    },
    "GasBenchmark": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address"
        },
        "contractLabel": {
          "type": "string"
        },
        "signature": {
          "type": "string",
          "description": "e.g. \"deposit(uint256)\"."
        },
        "before": {
          "type": "number"
        },
        "after": {
          "type": "number"
        }
      },
      "required": [
        "contract",
        "signature",
        "before",
        "after"
      ],
      "additionalProperties": false,
      "description": "Gas cost of a function before vs after the proposal executes."
    },
    "IsoDateTime": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp.",
      "format": "date-time"
    }
  }
}
