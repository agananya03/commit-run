{
  "$id": "https://proofofintent.local/schemas/FlagEvent.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/FlagEvent",
  "definitions": {
    "FlagEvent": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "operationId": {
          "$ref": "#/definitions/Hash32"
        },
        "reason": {
          "type": "string"
        },
        "reasonHash": {
          "$ref": "#/definitions/Hash32",
          "description": "keccak256 of `reason`, as passed on chain."
        },
        "guard": {
          "$ref": "#/definitions/Address"
        },
        "txHash": {
          "$ref": "#/definitions/Hash32"
        },
        "blockNumber": {
          "type": "number"
        },
        "flaggedBy": {
          "$ref": "#/definitions/Address"
        },
        "auto": {
          "type": "boolean",
          "description": "True when raised by the pipeline, false for POST /flag."
        },
        "flaggedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "proposalId",
        "operationId",
        "reason",
        "reasonHash",
        "guard",
        "txHash",
        "blockNumber",
        "flaggedBy",
        "auto",
        "flaggedAt"
      ],
      "additionalProperties": false,
      "description": "Result of GovernanceGuard.flag(operationId, reasonHash)."
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    },
    "Hash32": {
      "type": "string",
      "description": "32-byte hash, 0x-prefixed (keccak256 unless stated otherwise).",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "Address": {
      "type": "string",
      "description": "20-byte EVM address, 0x-prefixed (checksum optional).",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "IsoDateTime": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp.",
      "format": "date-time"
    }
  }
}
