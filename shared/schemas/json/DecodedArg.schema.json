{
  "$id": "https://proofofintent.local/schemas/DecodedArg.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/DecodedArg",
  "definitions": {
    "DecodedArg": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Solidity type, e.g. \"address\", \"uint256\", \"bytes\"."
        },
        "value": {
          "type": "string",
          "description": "Stringified value; bytes and arrays stay as hex / JSON text."
        }
      },
      "required": [
        "name",
        "type",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
