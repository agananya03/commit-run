{
  "$id": "https://proofofintent.local/schemas/Proposal.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Proposal",
  "definitions": {
    "Proposal": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/ProposalId"
        },
        "title": {
          "type": "string"
        },
        "proposer": {
          "$ref": "#/definitions/Address"
        },
        "governorProposalId": {
          "$ref": "#/definitions/Uint256"
        },
        "operationId": {
          "$ref": "#/definitions/Hash32"
        },
        "state": {
          "$ref": "#/definitions/ProposalState"
        },
        "analysisStatus": {
          "anyOf": [
            {
              "$ref": "#/definitions/JobStatus"
            },
            {
              "type": "string",
              "const": "idle"
            }
          ]
        },
        "riskScore": {
          "$ref": "#/definitions/Probability",
          "description": "Final posterior of the risk chain, once scored."
        },
        "riskLevel": {
          "$ref": "#/definitions/RiskLevel"
        },
        "flagged": {
          "type": "boolean"
        },
        "createdAt": {
          "$ref": "#/definitions/IsoDateTime"
        },
        "updatedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "id",
        "title",
        "proposer",
        "state",
        "analysisStatus",
        "flagged",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    },
    "Address": {
      "type": "string",
      "description": "20-byte EVM address, 0x-prefixed (checksum optional).",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "Uint256": {
      "type": "string",
      "description": "uint256 as a base-10 string.",
      "pattern": "^[0-9]+$"
    },
    "Hash32": {
      "type": "string",
      "description": "32-byte hash, 0x-prefixed (keccak256 unless stated otherwise).",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "ProposalState": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "canceled",
        "defeated",
        "succeeded",
        "queued",
        "expired",
        "executed"
      ],
      "description": "OpenZeppelin Governor ProposalState, lower-cased."
    },
    "JobStatus": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ]
    },
    "Probability": {
      "type": "number",
      "description": "Probability in [0, 1].",
      "minimum": 0,
      "maximum": 1
    },
    "RiskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "IsoDateTime": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp.",
      "format": "date-time"
    }
  }
}
