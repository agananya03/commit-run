{
  "$id": "https://proofofintent.local/schemas/SelectorChange.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SelectorChange",
  "definitions": {
    "SelectorChange": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address",
          "description": "Contract whose state changed (the token, for approvals)."
        },
        "contractLabel": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "description": {
          "type": "string",
          "description": "One human-readable line for the UI."
        },
        "kind": {
          "type": "string",
          "enum": [
            "selector_added",
            "selector_removed"
          ]
        },
        "selector": {
          "$ref": "#/definitions/Selector"
        },
        "signature": {
          "type": "string"
        }
      },
      "required": [
        "contract",
        "description",
        "kind",
        "selector",
        "severity"
      ],
      "additionalProperties": false
    },
    "Address": {
      "type": "string",
      "description": "20-byte EVM address, 0x-prefixed (checksum optional).",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "Selector": {
      "type": "string",
      "description": "4-byte function selector, 0x-prefixed.",
      "pattern": "^0x[0-9a-fA-F]{8}$"
    }
  }
}
