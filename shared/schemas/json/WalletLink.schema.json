{
  "$id": "https://proofofintent.local/schemas/WalletLink.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/WalletLink",
  "definitions": {
    "WalletLink": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "kind": {
          "$ref": "#/definitions/WalletLinkKind"
        },
        "confidence": {
          "$ref": "#/definitions/Probability"
        },
        "evidence": {
          "type": "string",
          "description": "Why we believe the link exists."
        },
        "txHash": {
          "$ref": "#/definitions/Hash32"
        },
        "documentId": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "kind",
        "confidence",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Address": {
      "type": "string",
      "description": "20-byte EVM address, 0x-prefixed (checksum optional).",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "WalletLinkKind": {
      "type": "string",
      "enum": [
        "funded_by",
        "same_deployer",
        "social_claim",
        "ens",
        "token_flow",
        "co_signer",
        "beneficiary_of"
      ]
    },
    "Probability": {
      "type": "number",
      "description": "Probability in [0, 1].",
      "minimum": 0,
      "maximum": 1
    },
    "Hash32": {
      "type": "string",
      "description": "32-byte hash, 0x-prefixed (keccak256 unless stated otherwise).",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    }
  }
}
