{
  "$id": "https://proofofintent.local/schemas/AnalysisJob.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AnalysisJob",
  "definitions": {
    "AnalysisJob": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "status": {
          "$ref": "#/definitions/JobStatus"
        },
        "step": {
          "$ref": "#/definitions/AnalysisStep"
        },
        "progress": {
          "type": "number",
          "description": "0 to 100."
        },
        "error": {
          "type": "string"
        },
        "queuedAt": {
          "$ref": "#/definitions/IsoDateTime"
        },
        "startedAt": {
          "$ref": "#/definitions/IsoDateTime"
        },
        "finishedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "jobId",
        "proposalId",
        "status",
        "progress",
        "queuedAt"
      ],
      "additionalProperties": false,
      "description": "GET /jobs/:jobId"
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    },
    "JobStatus": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ]
    },
    "AnalysisStep": {
      "type": "string",
      "enum": [
        "ingest",
        "summarize",
        "extract_intent",
        "simulate",
        "coi",
        "voting",
        "score",
        "commit",
        "flag"
      ]
    },
    "IsoDateTime": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp.",
      "format": "date-time"
    }
  }
}
