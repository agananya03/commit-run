{
  "$id": "https://proofofintent.local/schemas/AnalyzeRequest.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AnalyzeRequest",
  "definitions": {
    "AnalyzeRequest": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceInput"
          },
          "description": "Defaults to every source found under data/<proposalId>/."
        },
        "autoFlag": {
          "type": "boolean",
          "description": "Raise GovernanceGuard.flag() automatically on deviation (default true)."
        }
      },
      "additionalProperties": false,
      "description": "POST /proposals/:id/analyze"
    },
    "SourceInput": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/SourceKind"
        },
        "uri": {
          "type": "string",
          "description": "Path relative to the repo root (e.g. data/MIP-21/forum.json) or a URL."
        }
      },
      "required": [
        "kind",
        "uri"
      ],
      "additionalProperties": false
    },
    "SourceKind": {
      "type": "string",
      "enum": [
        "forum",
        "pdf",
        "social",
        "calldata"
      ]
    }
  }
}
