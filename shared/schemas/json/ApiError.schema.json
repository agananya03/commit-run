{
  "$id": "https://proofofintent.local/schemas/ApiError.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ApiError",
  "definitions": {
    "ApiError": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "description": "Machine-readable, e.g. \"NOT_FOUND\", \"VALIDATION_FAILED\", \"UPSTREAM_INVALID\"."
            },
            "message": {
              "type": "string"
            },
            "details": {}
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "description": "Body of every 4xx/5xx response, from all three services."
    }
  }
}
