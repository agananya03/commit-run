{
  "$id": "https://proofofintent.local/schemas/WalletNode.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/WalletNode",
  "definitions": {
    "WalletNode": {
      "type": "object",
      "properties": {
        "address": {
          "$ref": "#/definitions/Address"
        },
        "label": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WalletRole"
          }
        },
        "votingPower": {
          "$ref": "#/definitions/Uint256"
        }
      },
      "required": [
        "address",
        "roles"
      ],
      "additionalProperties": false
    },
    "Address": {
      "type": "string",
      "description": "20-byte EVM address, 0x-prefixed (checksum optional).",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "WalletRole": {
      "type": "string",
      "enum": [
        "proposer",
        "alt_wallet",
        "delegate",
        "voter",
        "beneficiary",
        "contract",
        "unknown"
      ]
    },
    "Uint256": {
      "type": "string",
      "description": "uint256 as a base-10 string.",
      "pattern": "^[0-9]+$"
    }
  }
}
