{
  "$id": "https://proofofintent.local/schemas/EvidenceTrail.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/EvidenceTrail",
  "definitions": {
    "EvidenceTrail": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvidenceEntry"
          }
        },
        "head": {
          "$ref": "#/definitions/Hash32"
        },
        "verified": {
          "type": "boolean",
          "description": "Recomputed every hash and matched the latest on-chain commit."
        }
      },
      "required": [
        "proposalId",
        "entries",
        "head",
        "verified"
      ],
      "additionalProperties": false,
      "description": "GET /proposals/:id/evidence"
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    },
    "EvidenceEntry": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "index": {
          "type": "number"
        },
        "kind": {
          "$ref": "#/definitions/EvidenceKind"
        },
        "refId": {
          "type": "string",
          "description": "Id of the referenced object, e.g. a SourceDocument.id or job id."
        },
        "payloadHash": {
          "$ref": "#/definitions/Hash32",
          "description": "keccak256 of the canonical JSON (sorted keys) of the payload."
        },
        "prevHash": {
          "$ref": "#/definitions/Hash32"
        },
        "entryHash": {
          "$ref": "#/definitions/Hash32"
        },
        "commit": {
          "$ref": "#/definitions/EvidenceCommit",
          "description": "Set when this entry's hash was committed on chain as the chain head."
        },
        "createdAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "proposalId",
        "index",
        "kind",
        "payloadHash",
        "prevHash",
        "entryHash",
        "createdAt"
      ],
      "additionalProperties": false,
      "description": "One link of the hash chain. entryHash = keccak256(abi.encode(uint256 index, bytes32 prevHash, string kind, bytes32 payloadHash)) The genesis entry (index 0) has prevHash = 0x00...00."
    },
    "EvidenceKind": {
      "type": "string",
      "enum": [
        "source_document",
        "summary",
        "intent",
        "simulation",
        "coi",
        "voting",
        "risk",
        "flag"
      ]
    },
    "Hash32": {
      "type": "string",
      "description": "32-byte hash, 0x-prefixed (keccak256 unless stated otherwise).",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "EvidenceCommit": {
      "type": "object",
      "properties": {
        "registry": {
          "$ref": "#/definitions/Address",
          "description": "EvidenceRegistry contract address."
        },
        "txHash": {
          "$ref": "#/definitions/Hash32"
        },
        "blockNumber": {
          "type": "number"
        },
        "committedAt": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "registry",
        "txHash",
        "blockNumber",
        "committedAt"
      ],
      "additionalProperties": false
    },
    "Address": {
      "type": "string",
      "description": "20-byte EVM address, 0x-prefixed (checksum optional).",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "IsoDateTime": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp.",
      "format": "date-time"
    }
  }
}
