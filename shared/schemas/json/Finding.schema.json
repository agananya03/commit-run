{
  "$id": "https://proofofintent.local/schemas/Finding.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/Finding",
  "definitions": {
    "Finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "recipient_mismatch",
            "amount_mismatch",
            "undeclared_action",
            "ownership_change",
            "unlimited_approval",
            "new_privileged_function",
            "coi",
            "unsupported_claim",
            "contradiction"
          ]
        },
        "said": {
          "type": "string"
        },
        "does": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Citation"
          }
        },
        "simRef": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "category",
        "said",
        "does",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Citation": {
      "type": "object",
      "properties": {
        "chunkId": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/definitions/Hex"
        },
        "quote": {
          "type": "string"
        },
        "sourceUri": {
          "type": "string"
        }
      },
      "required": [
        "chunkId",
        "sha256",
        "quote",
        "sourceUri"
      ],
      "additionalProperties": false
    },
    "Hex": {
      "type": "string"
    }
  }
}
