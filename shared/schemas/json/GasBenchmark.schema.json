{
  "$id": "https://proofofintent.local/schemas/GasBenchmark.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/GasBenchmark",
  "definitions": {
    "GasBenchmark": {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/definitions/Address"
        },
        "contractLabel": {
          "type": "string"
        },
        "signature": {
          "type": "string",
          "description": "e.g. \"deposit(uint256)\"."
        },
        "before": {
          "type": "number"
        },
        "after": {
          "type": "number"
        }
      },
      "required": [
        "contract",
        "signature",
        "before",
        "after"
      ],
      "additionalProperties": false,
      "description": "Gas cost of a function before vs after the proposal executes."
    },
    "Address": {
      "type": "string",
      "description": "20-byte EVM address, 0x-prefixed (checksum optional).",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    }
  }
}
