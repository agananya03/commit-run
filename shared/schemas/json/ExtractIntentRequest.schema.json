{
  "$id": "https://proofofintent.local/schemas/ExtractIntentRequest.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ExtractIntentRequest",
  "definitions": {
    "ExtractIntentRequest": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        }
      },
      "required": [
        "proposalId"
      ],
      "additionalProperties": false,
      "description": "POST /extract-intent"
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    }
  }
}
