{
  "$id": "https://proofofintent.local/schemas/IntentClaim.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/IntentClaim",
  "definitions": {
    "IntentClaim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique within the response, e.g. \"c1\"."
        },
        "category": {
          "$ref": "#/definitions/ClaimCategory"
        },
        "statement": {
          "type": "string",
          "description": "Normalised statement, e.g. \"No change to ownership\"."
        },
        "expectation": {
          "type": "string",
          "enum": [
            "change",
            "no_change"
          ],
          "description": "Whether the text says this thing changes or explicitly stays the same."
        },
        "subject": {
          "type": "string",
          "description": "What the claim is about, e.g. \"MeridianReserve.owner\"."
        },
        "confidence": {
          "$ref": "#/definitions/Probability"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Citation"
          }
        }
      },
      "required": [
        "id",
        "category",
        "statement",
        "expectation",
        "confidence",
        "citations"
      ],
      "additionalProperties": false,
      "description": "Something the proposal text promises about its own effect."
    },
    "ClaimCategory": {
      "type": "string",
      "enum": [
        "gas",
        "ownership",
        "funds",
        "permissions",
        "upgrade",
        "parameters",
        "other"
      ]
    },
    "Probability": {
      "type": "number",
      "description": "Probability in [0, 1].",
      "minimum": 0,
      "maximum": 1
    },
    "Citation": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "description": "SourceDocument.id the quote comes from."
        },
        "chunkId": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "description": "Verbatim excerpt supporting the statement."
        },
        "page": {
          "type": "number",
          "description": "1-based page number for PDFs."
        }
      },
      "required": [
        "documentId",
        "quote"
      ],
      "additionalProperties": false
    }
  }
}
