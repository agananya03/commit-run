{
  "$id": "https://proofofintent.local/schemas/AnalysisProgressEvent.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AnalysisProgressEvent",
  "definitions": {
    "AnalysisProgressEvent": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "step": {
          "$ref": "#/definitions/AnalysisStep"
        },
        "status": {
          "type": "string",
          "enum": [
            "started",
            "completed",
            "failed"
          ]
        },
        "progress": {
          "type": "number",
          "description": "0 to 100, for the whole job."
        },
        "message": {
          "type": "string"
        },
        "at": {
          "$ref": "#/definitions/IsoDateTime"
        }
      },
      "required": [
        "jobId",
        "proposalId",
        "step",
        "status",
        "progress",
        "at"
      ],
      "additionalProperties": false
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    },
    "AnalysisStep": {
      "type": "string",
      "enum": [
        "ingest",
        "summarize",
        "extract_intent",
        "simulate",
        "coi",
        "voting",
        "score",
        "commit",
        "flag"
      ]
    },
    "IsoDateTime": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp.",
      "format": "date-time"
    }
  }
}
