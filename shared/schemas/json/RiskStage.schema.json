{
  "$id": "https://proofofintent.local/schemas/RiskStage.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/RiskStage",
  "definitions": {
    "RiskStage": {
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "enum": [
            "claims",
            "coi",
            "voting",
            "execution"
          ]
        },
        "probability": {
          "type": "number"
        },
        "likelihoodRatio": {
          "type": "number"
        },
        "explanation": {
          "type": "string"
        },
        "findingIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "stage",
        "probability",
        "likelihoodRatio",
        "explanation",
        "findingIds"
      ],
      "additionalProperties": false
    }
  }
}
