{
  "$id": "https://proofofintent.local/schemas/RiskStage.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/RiskStage",
  "definitions": {
    "RiskStage": {
      "type": "object",
      "properties": {
        "stage": {
          "$ref": "#/definitions/RiskStageName"
        },
        "prior": {
          "$ref": "#/definitions/Probability"
        },
        "likelihoodRatio": {
          "type": "number"
        },
        "posterior": {
          "$ref": "#/definitions/Probability"
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RiskSignal"
          }
        }
      },
      "required": [
        "stage",
        "prior",
        "likelihoodRatio",
        "posterior",
        "signals"
      ],
      "additionalProperties": false,
      "description": "One Bayesian update: posterior odds = prior odds * likelihoodRatio, where likelihoodRatio is the product of the signals' ratios. Each stage's prior is the previous stage's posterior."
    },
    "RiskStageName": {
      "type": "string",
      "enum": [
        "claims",
        "coi",
        "voting",
        "execution"
      ]
    },
    "Probability": {
      "type": "number",
      "description": "Probability in [0, 1].",
      "minimum": 0,
      "maximum": 1
    },
    "RiskSignal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "likelihoodRatio": {
          "type": "number",
          "description": "Likelihood ratio this signal contributes; >1 raises risk, <1 lowers it."
        },
        "evidenceIndex": {
          "type": "number",
          "description": "EvidenceEntry.index backing this signal."
        }
      },
      "required": [
        "id",
        "description",
        "likelihoodRatio"
      ],
      "additionalProperties": false
    }
  }
}
