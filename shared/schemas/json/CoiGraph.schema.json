{
  "$id": "https://proofofintent.local/schemas/CoiGraph.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/CoiGraph",
  "definitions": {
    "CoiGraph": {
      "type": "object",
      "properties": {
        "proposalId": {
          "$ref": "#/definitions/ProposalId"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WalletNode"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WalletLink"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CoiFinding"
          }
        }
      },
      "required": [
        "proposalId",
        "nodes",
        "links",
        "findings"
      ],
      "additionalProperties": false,
      "description": "GET /proposals/:id/coi"
    },
    "ProposalId": {
      "type": "string",
      "description": "Meridian Improvement Proposal id.",
      "pattern": "^MIP-[0-9]+$"
    },
    "WalletNode": {
      "type": "object",
      "properties": {
        "address": {
          "$ref": "#/definitions/Address"
        },
        "label": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/WalletRole"
          }
        },
        "votingPower": {
          "$ref": "#/definitions/Uint256"
        }
      },
      "required": [
        "address",
        "roles"
      ],
      "additionalProperties": false
    },
    "Address": {
      "type": "string",
      "description": "20-byte EVM address, 0x-prefixed (checksum optional).",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "WalletRole": {
      "type": "string",
      "enum": [
        "proposer",
        "alt_wallet",
        "delegate",
        "voter",
        "beneficiary",
        "contract",
        "unknown"
      ]
    },
    "Uint256": {
      "type": "string",
      "description": "uint256 as a base-10 string.",
      "pattern": "^[0-9]+$"
    },
    "WalletLink": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "kind": {
          "$ref": "#/definitions/WalletLinkKind"
        },
        "confidence": {
          "$ref": "#/definitions/Probability"
        },
        "evidence": {
          "type": "string",
          "description": "Why we believe the link exists."
        },
        "txHash": {
          "$ref": "#/definitions/Hash32"
        },
        "documentId": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "kind",
        "confidence",
        "evidence"
      ],
      "additionalProperties": false
    },
    "WalletLinkKind": {
      "type": "string",
      "enum": [
        "funded_by",
        "same_deployer",
        "social_claim",
        "ens",
        "token_flow",
        "co_signer",
        "beneficiary_of"
      ]
    },
    "Probability": {
      "type": "number",
      "description": "Probability in [0, 1].",
      "minimum": 0,
      "maximum": 1
    },
    "Hash32": {
      "type": "string",
      "description": "32-byte hash, 0x-prefixed (keccak256 unless stated otherwise).",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "CoiFinding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "addresses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Address"
          }
        },
        "probability": {
          "$ref": "#/definitions/Probability"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        }
      },
      "required": [
        "id",
        "summary",
        "addresses",
        "probability",
        "severity"
      ],
      "additionalProperties": false
    },
    "Severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    }
  }
}
